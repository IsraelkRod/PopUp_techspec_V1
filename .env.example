# Copy to .env and fill in. .env is gitignored — never commit real secrets.

PORT=3000
JWT_SECRET=change-me
JWT_EXPIRES_IN=1h
POPUP_POS_WEBHOOK_SECRET=change-me

# Token encryption (32+ char random string in production)
SECRET_ENCRYPTION_KEY=change-me

# Square (start in sandbox)
SQUARE_ENVIRONMENT=sandbox
SQUARE_APPLICATION_ID=
SQUARE_APPLICATION_SECRET=
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_REDIRECT_URL=http://localhost:3000/connect/square/callback

# Clover (sandbox)
CLOVER_ENVIRONMENT=sandbox
CLOVER_APP_ID=
CLOVER_APP_SECRET=
CLOVER_REDIRECT_URL=http://localhost:3000/connect/clover/callback

# Stripe Connect
STRIPE_CONNECT_CLIENT_ID=
STRIPE_SECRET_KEY=
STRIPE_REDIRECT_URL=http://localhost:3000/connect/stripe/callback
